#!/usr/bin/env bash
# Project quality gates for pyludusavi. Invoked by orchestration/run-quality-gates
# from the repo root. Exit non-zero to fail the gate.
#
# These mirror AGENTS.md §12 but run in CHECK-ONLY mode (no --fix / no format
# rewrite) so the gate verifies the tree without mutating it and leaving the
# worktree dirty. The implementer applies the auto-fixing variants during its own
# work; this gate confirms the result is already clean.
set -euo pipefail

# Run everything through the project wrapper so caches/venv land under /tmp.
./run.sh uv run ruff check .
./run.sh uv run ruff format --check .
./run.sh uv run ty check src/
./run.sh uv run pytest
